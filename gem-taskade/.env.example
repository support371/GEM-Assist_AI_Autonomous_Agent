# ─── Supabase (free tier, no card) ───
# Create project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── AI proxy ───
# Routes to your Cloudflare Worker /llm endpoint.
# The Worker itself runs the free-tier AI stack: Cloudflare Workers AI → Gemini → Groq.
# NO paid AI subscription required. NO API keys exposed in the browser.
VITE_LLM_PROXY_URL=https://gem-bot.YOUR-SUBDOMAIN.workers.dev/llm

# ─── Cloudflare Worker secrets (set with: wrangler secret put NAME) ───
# TG_BOT_TOKEN           → from @BotFather
# TG_WEBHOOK_SECRET      → random string you choose
# TG_CHANNEL             → @mycybersecureWealthsolution
# ADMIN_SECRET           → random, protects the /publish endpoint
# ALLOWED_ORIGINS        → https://your-app.vercel.app,https://custom.domain
#
# AI providers — all FREE, no credit card required:
# GEMINI_API_KEY         → https://aistudio.google.com/apikey  (1,500 req/day free)
# GROQ_API_KEY           → https://console.groq.com/keys       (14,400 req/day free)
# (Cloudflare Workers AI is enabled via the [ai] binding in wrangler.toml — no key needed.
#  Free tier: 10,000 Neurons/day on the base Workers plan.)
#
# Optional (for Telegram bot history + daily digest):
# SUPABASE_URL
# SUPABASE_SERVICE_KEY
